# Copy to .env.local and fill in real values. Never commit .env.local.

# Server-side only (no NEXT_PUBLIC_ prefix): used by the grounded AI routes.
ANTHROPIC_API_KEY=

# Public config (safe to expose to the browser).
NEXT_PUBLIC_SITE_URL=

# Supabase auth (publishable/anon key — safe to expose to the browser).
# From Supabase dashboard > Project Settings > API. Auth only; the browser-only
# profile (name, town, life facts, topics) is never sent to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
