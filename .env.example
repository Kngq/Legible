# Copy to .env.local and fill in real values. Never commit .env.local.

# Server-side only (no NEXT_PUBLIC_ prefix): used by the grounded AI routes.
ANTHROPIC_API_KEY=

# Server-side only: feed photos (src/app/api/photos). Pixabay search, then upload
# to the Supabase Storage bucket below. The bucket must allow public reads.
PIXABAY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=
# Set to "local" to keep photos in .photos/ on this machine instead (development only).
PHOTO_STORE=

# Public config (safe to expose to the browser).
NEXT_PUBLIC_SITE_URL=
